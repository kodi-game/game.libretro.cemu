msgctxt "#30024"
msgid "Precompiled Shaders (OpenGL)"
msgstr ""

msgctxt "#30025"
msgid "A cache of compiled shader programs. Auto: the game profile's setting where it has one, as standalone; else off on Nvidia, whose driver keeps its own cache, and on elsewhere."
msgstr ""

msgctxt "#30026"
msgid "Async Shader Compile (Vulkan)"
msgstr ""

msgctxt "#30027"
msgid "Accurate Shader Multiplication"
msgstr ""

msgctxt "#30028"
msgid "Emulates the GPU's multiplication exactly, as most games need. Auto: the game profile's setting where it has one, as standalone (Super Mario 3D World, Captain Toad and Xenoblade Chronicles X run with it off); else on."
msgstr ""

msgctxt "#30029"
msgid "GX2DrawDone Sync"
msgstr ""

msgctxt "#30030"
msgid "Makes the game wait until the GPU has finished all its work whenever it calls GX2DrawDone, as standalone's Full sync at GX2DrawDone. Some games need it to show correctly; off can be faster. Can be toggled during gameplay."
msgstr ""

msgctxt "#30031"
msgid "Accurate Barriers (Vulkan)"
msgstr ""

msgctxt "#30032"
msgid "Keeps the synchronization between draws that some games need to render correctly, as standalone's option of that name. Off can be faster, with glitches in those games. Can be toggled during gameplay."
msgstr ""

